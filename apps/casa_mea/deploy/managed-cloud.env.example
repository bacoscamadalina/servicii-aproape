# Varianta dev cere doar administratorul inițial. Nu comite valorile reale.
CASAMEA_ADMIN_USERNAME=administrator
CASAMEA_ADMIN_EMAIL=administrator@exemplu.ro
CASAMEA_ADMIN_PASSWORD=INLOCUIESTE_CU_O_PAROLA_ADMIN_PUTERNICA

# Opțional: implicit este o parolă internă de dezvoltare, iar baza nu expune port.
CASAMEA_POSTGRES_PASSWORD=INLOCUIESTE_DACA_DORESTI

# Opțional: prețul lunar afișat public, în lei. Implicit: 49.
CASAMEA_SUBSCRIPTION_MONTHLY_PRICE_RON=49
