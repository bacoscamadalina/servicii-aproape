# Copy to .env on the private cloud host; never commit the completed file.
CASAMEA_DOMAIN=servicii.example.com
# Generate two DIFFERENT values with: python -c "import secrets; print(secrets.token_urlsafe(64))"
CASAMEA_SECRET_KEY=
CASAMEA_POSTGRES_PASSWORD=
CASAMEA_BACKUP_DIR=./deploy/backups/current
# Periodic verification fails when the newest selected bundle is older than this.
CASAMEA_BACKUP_MAX_AGE_HOURS=26

# SMTP with mandatory STARTTLS. Production refuses to start without these values.
CASAMEA_EMAIL_HOST=smtp.example.com
CASAMEA_EMAIL_PORT=587
CASAMEA_EMAIL_HOST_USER=
CASAMEA_EMAIL_HOST_PASSWORD=
CASAMEA_DEFAULT_FROM_EMAIL=ServiciiAproape <no-reply@example.com>

# Public legal identity shown in the privacy notice and site footer.
CASAMEA_LEGAL_OPERATOR_NAME=
CASAMEA_LEGAL_OPERATOR_ADDRESS=
CASAMEA_PRIVACY_EMAIL=privacy@example.com
CASAMEA_COMMERCIAL_EMAIL=contact@example.com

# Prețurile lunare afișate pe pagina publică a abonamentelor, în lei.
CASAMEA_SUBSCRIPTION_MONTHLY_PRICE_RON=49
CASAMEA_MANAGED_SITE_MONTHLY_PRICE_RON=299
# Flux temporar fără procesator și fără tranzacții. Schimbă în 0 înainte de plata reală.
CASAMEA_SIMULATED_CHECKOUT_ENABLED=1

# Durate aprobate de operator; producția refuză valori lipsă sau în afara limitelor.
CASAMEA_RETENTION_UNVERIFIED_CLAIM_DAYS=30
CASAMEA_RETENTION_REJECTED_CLAIM_DAYS=365
CASAMEA_RETENTION_CLOSED_REPORT_DAYS=365
CASAMEA_RETENTION_CLOSED_DATA_REQUEST_DAYS=1095
CASAMEA_RETENTION_MANAGED_SITE_INQUIRY_DAYS=365
